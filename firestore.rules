rules_version = '2';

// ⚠️ กติกาชุดนี้เปิดให้อ่าน/เขียนได้แบบเปิดกว้าง เหมาะสำหรับ "ทดลองใช้งานตอนพัฒนา" เท่านั้น
// ก่อนขึ้นใช้งานจริง ควรจำกัดสิทธิ์เขียนเฉพาะผู้ใช้ที่ล็อกอินแล้ว/เป็นแอดมิน
// (ตอนนี้แอปยังไม่ได้ผูกกับ Firebase Authentication ระบบล็อกอินเป็นแบบเช็ค username/password เองในแอป
//  จึงยังไม่มีวิธีตรวจสอบตัวตนฝั่ง Firestore Rules ได้ — ถ้าต้องการความปลอดภัยสูงขึ้น
//  แนะนำให้เปลี่ยนไปใช้ Firebase Authentication ควบคู่ไปด้วยในอนาคต)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
